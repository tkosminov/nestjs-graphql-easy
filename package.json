{
  "name": "nestjs-graphql-easy",
  "version": "3.1.5",
  "description": "A library for NestJS that implements a dataloader (including for polymorphic relation) for graphql, as well as automatic generation of arguments for filters, sorting and pagination, and their processing in the dataloader.",
  "author": "t.kosminov",
  "license": "MIT",
  "private": false,
  "main": "dist-lib/index.js",
  "types": "dist-lib/index.d.ts",
  "files": [
    "dist-lib"
  ],
  "keywords": [
    "graphql",
    "nestjs",
    "typeorm",
    "dataloader",
    "tools",
    "polymorphic",
    "filtering",
    "ordering",
    "sorting",
    "pagination",
    "cursor-pagination",
    "n+1"
  ],
  "repository": {
    "url": "https://github.com/tkosminov/nestjs-graphql-easy"
  },
  "scripts": {
    "build": "rimraf dist-lib && tsc -p tsconfig.lib.json",
    "start:debug": "nodemon --config nodemon-debug.json",
    "start:dev": "nodemon",
    "build:dev": "rimraf dist && tsc -p tsconfig.build.json",
    "start:build:dev": "NODE_ENV=development node -r ts-node/register -r tsconfig-paths/register dist/src/main.js",
    "lint": "eslint \"{src,lib}/**/*.ts\"",
    "lint-fix": "npm run lint -- --fix",
    "typeorm:cli": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "db:migration:create": "npm run typeorm:cli -- migration:create ./src/database/migrations/created",
    "db:migration:run": "npm run typeorm:cli -- -d ./src/database/database-ormconfig.cli.ts migration:run",
    "db:schema:sync": "npm run typeorm:cli -- -d ./src/database/database-ormconfig.cli.ts schema:sync"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  },
  "peerDependencies": {
    "@nestjs/common": ">= 9.0.0",
    "@nestjs/core": ">= 9.0.0",
    "@nestjs/graphql": ">= 10.0.0",
    "@nestjs/typeorm": ">= 9.0.0",
    "class-transformer": ">= 0.5.0",
    "class-validator": ">= 0.13.0",
    "graphql": ">= 16.0.0",
    "typeorm": ">= 0.3.0"
  },
  "dependencies": {
    "dataloader": "^2.0.0",
    "nanoid": "^3.3.4"
  },
  "devDependencies": {
    "@apollo/server": "^4.11.3",
    "@nestjs/apollo": "^13.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.2",
    "@nestjs/graphql": "^13.0.1",
    "@nestjs/platform-express": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/body-parser": "^1.19.5",
    "@types/config": "^3.3.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemon": "^1.19.6",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "body-parser": "^1.20.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "config": "^3.3.12",
    "cookie-parser": "^1.4.7",
    "dataloader": "^2.2.3",
    "graphql": "^16.10.0",
    "graphql-scalars": "^1.24.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.0.1",
    "helmet": "^8.0.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.9",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.20",
    "typeorm-extension": "^3.6.3",
    "typescript": "^5.7.3",
    "uuid": "^11.0.5"
  }
}
