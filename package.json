{
  "name": "nestjs-graphql-easy",
  "version": "4.0.0",
  "description": "A library for NestJS that implements a dataloader (including for polymorphic relation) for graphql, as well as automatic generation of arguments for filters, sorting and pagination, and their processing in the dataloader.",
  "author": "t.kosminov",
  "license": "MIT",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    }
  },
  "main": "dist-lib/index.js",
  "types": "dist-lib/index.d.ts",
  "files": [
    "dist-lib"
  ],
  "keywords": [
    "graphql",
    "nestjs",
    "typeorm",
    "dataloader",
    "tools",
    "polymorphic",
    "filtering",
    "ordering",
    "sorting",
    "pagination",
    "cursor-pagination",
    "n+1"
  ],
  "repository": {
    "url": "https://github.com/tkosminov/nestjs-graphql-easy"
  },
  "scripts": {
    "build": "nest build -p ./tsconfig.build.json",
    "build:lib": "nest build -p ./tsconfig.lib.json",
    "prestart": "npm run build:lib",
    "start": "NODE_ENV=development nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"lib/**/*.ts\"",
    "lint": "oxlint src/ lib/",
    "typeorm:cli": "NODE_ENV=development node ./node_modules/typeorm/cli",
    "typeorm:create": "npm run typeorm:cli -- migration:create ./src/typeorm/migrations/${MIGRATION_NAME}"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/typeorm": "^12.0.0",
    "graphql": "^16.0.0 || ^17.0.0",
    "typeorm": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  },
  "dependencies": {
    "dataloader": "^2.2.3",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.1",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/graphql": "^14.0.1",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/schematics": "^12.0.4",
    "@nestjs/typeorm": "^12.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "body-parser": "^2.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv-flow": "^4.1.0",
    "graphql": "^16.14.2",
    "graphql-scalars": "^2.0.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.2.2",
    "helmet": "^8.3.0",
    "oxlint": "^1.85.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "source-map-support": "^0.5.21",
    "tslib": "^2.8.1",
    "typeorm": "^1.1.1",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  }
}
